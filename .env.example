# 复制为 .env 后填写（不要提交 .env）

# 编辑回推 GitHub 的 PAT
# 类型：Fine-grained personal access token
# 仓库：只选 sub-sift
# 权限：Contents: Read and write、Actions: Read and write
GIT_PUSH_TOKEN=

# web 管理端登录口令（留空则管理端免鉴权，仅限可信局域网）
WEB_TOKEN=

# 可选覆盖
# EDIT_TRIGGER_ACTIONS=true     # false = 编辑提交加 [skip ci]，不惊动 Actions
# SYNC_INTERVAL_HOURS=0         # 0 = 自动跟随 ci.yml 的 cron；填数字则手动指定
# SYNC_BUFFER_MINUTES=5         # 等 Actions 跑完的缓冲（实测单次运行 2-3 分钟）
# SYNC_POLL_SECONDS=180         # 检测窗口内的轮询间隔
# SYNC_MAX_WAIT_MINUTES=120     # 窗口内最多等多久
# WEB_PORT=8080
